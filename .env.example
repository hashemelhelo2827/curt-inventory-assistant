# Copy to .env and fill with your own keys - never commit .env
# Mistral (used in agent/model.py:23 open-mistral-nemo/mistral-tiny)
Mistral_API_key=your_mistral_key_here
Mistral_API_key2=your_mistral_second_key_here

# Gemini (optional fallback, not used now but kept for reference)
Gemini_APIKEY=your_gemini_key_here
Gemini_APIKEY2=your_gemini_second_key_here

# Flask
SECRET_KEY=super-secret-key-change-me

# Optional backend override for Streamlit
# BACKEND_URL=http://127.0.0.1:5000/chat

# Database is SQLite at database/curt_inventory.db (no env needed)
